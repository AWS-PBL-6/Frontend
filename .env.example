# Cognito + API config (from `sam deploy` stack outputs). VITE_ vars are public
# (bundled into the SPA) - no secrets here.
VITE_AWS_REGION=ap-northeast-2
VITE_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=ae-sentinel-<accountId>.auth.ap-northeast-2.amazoncognito.com
VITE_API_BASE=https://<restApiId>.execute-api.ap-northeast-2.amazonaws.com
VITE_WS_URL=wss://<wsApiId>.execute-api.ap-northeast-2.amazonaws.com/prod
# Set true only after the Google IdP is configured in Cognito (needs Google OAuth client).
VITE_ENABLE_GOOGLE=false
